{
  "manifest_version": 3,
  "name": "Advice Tracker (research study)",
  "version": "0.6.2",
  "description": "Study extension: notices when you ask an AI assistant for advice on a personal decision, asks you to rate the advice, and checks back two weeks later.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "http://localhost/*"
      ],
      "js": [
        "lib/sites.js",
        "lib/episodes.js",
        "lib/redact.js",
        "lib/questions.js",
        "lib/history.js",
        "lib/history/chatgpt.js",
        "lib/history/claude.js",
        "lib/history/gemini.js",
        "lib/history/grok.js",
        "lib/history/perplexity.js",
        "content/rating_panel.js",
        "content/capture.js",
        "content/history.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Advice Tracker"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "121"
}
